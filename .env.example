# Supabase. Copy to .env.local and fill in from the project's API settings.
#
#   npx supabase login
#   npx supabase link --project-ref <ref>
#   npx supabase db push          # applies supabase/migrations/
#
# The app runs without these — the marketing pages fall back to placeholder
# content — but accounts, community and admin all need them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
